# Funded private key for proxy signing (Hardhat dev key)
PROXY_PRIVATE_KEY="983760a4ebf75b2ac3a93531168a0f225d01e5dc6e3568adbd46233ba1fb4fa4"

# # Devnet
# INITIAL_OWNER="0xF4E021377420Afe90c1A7D2b8968904946633a64" # Initial owner address (derived from DEPLOYMENT_PRIVATE_KEY)
# DEPLOYMENT_PRIVATE_KEY="983760a4ebf75b2ac3a93531168a0f225d01e5dc6e3568adbd46233ba1fb4fa4" # Private key for the deployments and contract calls

# Coston
INITIAL_OWNER="0x123.."
DEPLOYMENT_PRIVATE_KEY="123..."

# TEE governance — the signer set + threshold that governs this extension's TEE
# machines. post-build registers it on-chain (set-governance) AND the TEE node
# signs with it; both read these same vars, so they always agree. If unset,
# defaults to GOVERNANCE_SIGNERS=<INITIAL_OWNER> (the deployer) and
# GOVERNANCE_THRESHOLD=1. Set your own to use a different governance set:
# GOVERNANCE_SIGNERS="0xAbc...,0xDef..."   # comma-separated 0x addresses
# GOVERNANCE_THRESHOLD=2

# Docker image registry (defaults to "local" for locally-built images)
# Uncomment to use remote registry:
# REGISTRY=registry.gitlab.com/flarenetwork/tee/e2e

# Chain RPC URL
CHAIN_URL=https://coston2-api.flare.network/ext/C/rpc

# Path to Coston2 deployed contract addresses
ADDRESSES_FILE=./config/coston2/deployed-addresses.json

# Must be false on live networks
LOCAL_MODE=false

# TEE attestation mode: true = use test code hash/platform (no real TEE hardware)
# Set to false when running on actual GCP Confidential VM with real attestation
SIMULATED_TEE=true

# Normal/FTDC proxy URL on Coston2
NORMAL_PROXY_URL=https://tee-proxy-coston2-1.flare.rocks

# Extension proxy URL (local)
# EXT_PROXY_URL=http://localhost:6674
EXT_PROXY_URL=https://<your-ngrok-url>.ngrok-free.dev

# --- Hyperliquid Controlled Accounts ---
# Testnet API (signing domain is selected by this URL).
HYPERLIQUID_URL=https://api.hyperliquid-testnet.xyz
# 32+ byte hex seed used to derive per-user HL keys (KEEP SECRET).
HL_MASTER_SEED=
# Private key (hex) of the faucet-funded treasury HL account (KEEP SECRET).
HL_TREASURY_KEY=
# Caps (USD) for the v1 mock deposit path.
HL_MAX_DEPOSIT_USD=1000
HL_MAX_TOTAL_DEPOSIT_USD=5000

# --- Arbitrum bridge funding path (real deposits/withdrawals via HL Bridge2) ---
# Arbitrum Sepolia RPC (HL testnet settles deposits/withdrawals here).
ARBITRUM_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
# HL testnet mock USDC token and Bridge2 contract on Arbitrum Sepolia.
# (Bridge2 only credits deposits of THIS token; a public USDC faucet won't work.)
ARB_USDC_ADDRESS=0x1baAbB04529D43a73232B713C0FE471f7c7334d5
HL_BRIDGE2_ADDRESS=0x08cfc1B6b2dCF36A1480b99353A354AA8AC56f89
# TEE-held Arbitrum reserve key (KEEP SECRET). Defaults to HL_TREASURY_KEY.
# Must hold a little Arbitrum Sepolia ETH for gas; bootstrap its USDC by
# withdrawing the treasury's HL balance to Arbitrum (see testing/arb_loop_test.go).
ARB_RESERVE_KEY=
# Funding mode: "treasury" (legacy spotSend from HL treasury) | "bridge"
# (real Arbitrum Bridge2 deposits + withdraw3). See docs/hyperliquid.md.
# HL_FUNDING_MODE=bridge
# Bridge-mode tunables (defaults shown):
# HL_MIN_DEPOSIT_USD=5            # Bridge2 ignores deposits below 5 USDC
# HL_RESERVE_AUTO_REFILL=false    # top up reserve USDC from its HL balance
# HL_RESERVE_REFILL_FLOOR_USD=50
# HL_RECONCILE_TOLERANCE_USD=0.01 # ledger-vs-HL drift below this is ignored
# HL_RECONCILE_INTERVAL_SECONDS=120  # background reconciler tick (0 = off)

