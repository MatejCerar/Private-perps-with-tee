.env*
*.env
!*.example

# Coston/Coston2 proxy configs (contain DB credentials)
config/proxy/extension_proxy.coston.toml
config/proxy/extension_proxy.coston.docker.toml
config/proxy/extension_proxy.coston2.toml
config/proxy/extension_proxy.coston2.docker.toml
config/extension.env
out/
cache/
.DS_Store

# Compiled Go binaries
tools/start-*
tools/allow-*
tools/deploy-*
tools/register-*
tools/run-*
tools/spot-send

# Playwright MCP artifacts
.playwright-mcp/

# Generated contract bindings (produced by scripts/generate-bindings.sh)
tools/pkg/contracts/*/autogen.go
tools/pkg/contracts/*/*.abi
tools/pkg/contracts/*/*.bin

docs/superpowers

notes/

# Private deployment guide (SSH, redeploy instructions)
DEPLOYMENT.md

config/**/*.log
# Per-deployment wallet registry (written by tools/cmd/provision-wallet)
config/wallet-registry.json

# Direct-TEE relayer binary + per-deployment TEE registration state
tools/relayer
config/register-tee.state

# Diff artifacts and stray root lockfile
*.patch
/package-lock.json

# e2e harness is a separately-cloned repo (its own .git); not vendored here.
# Its Coston2 indexer fixes are documented in docs/DEPLOY.md.
/e2e/
