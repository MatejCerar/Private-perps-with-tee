# Copy to .env.local and fill in. Restart `npm run dev` after changes.

# Which Flare testnet the InstructionSender is deployed on: coston | coston2
NEXT_PUBLIC_CHAIN=coston

# Deployed HyperliquidInstructionSender address (see ../config/extension.env).
# NOTE: this changes every time pre-build/full-setup redeploys the contract.
NEXT_PUBLIC_INSTRUCTION_SENDER=0x012bB7A094e044DA1fB6f7919f55A18f03304e57

# Vault-mode addresses (printed by `deploy-vault`). Required for the two-step
# deposit (mint→approve→escrow) and withdraw (request→executeWithdraw) flows.
NEXT_PUBLIC_TESTUSDC=
NEXT_PUBLIC_VAULT=

# Instruction fee forwarded as msg.value, in wei.
# Mirrors tools/pkg/utils/instructions.go (opts.Value = 1000000).
NEXT_PUBLIC_INSTRUCTION_FEE_WEI=1000000

# Public URL of the TEE proxy (SERVER-SIDE ONLY — never exposed to the browser).
# Today this is the ephemeral tunnel in front of the node, e.g.
#   https://<sub>.trycloudflare.com   or   https://<id>.ngrok-free.dev
# Must be reachable from wherever `next` runs (your laptop for the spike).
TEE_PROXY_URL=

# ---- Privacy upgrade ----

# Direct-TEE relayer (public URL). When set, deposit/withdraw/trade are delivered
# to the enclave via the relayer (bypassing FTDC consensus) while the on-chain
# escrow tx still runs. Local dev: http://localhost:8787. Production: the public
# URL of your tunneled relayer (see docs/DEPLOY.md).
NEXT_PUBLIC_RELAYER_URL=

# Privacy mode. Default on; set to "false" to fall back to the plain on-chain
# behaviour (arbitrary deposit amounts, on-chain trades, no pooled funding).
NEXT_PUBLIC_PRIVACY_MODE=true

# Fixed deposit denominations in USD (comma-separated). In privacy mode deposits
# are restricted to these so amounts do not fingerprint a user in the batch.
# Defaults to 25,100,500 when unset.
NEXT_PUBLIC_DENOMINATIONS=25,100,500

# Browser-reachable TEE gateway for direct, user-signed (gasless) trades. When
# set and privacy mode is on, place-order and cancel are signed and POSTed here
# instead of going on-chain. Leave empty to keep trades on-chain.
NEXT_PUBLIC_GATEWAY_URL=

# Chain id bound into every signed trade message (replay-domain separation).
# Must match the Go gateway. Defaults to 114 (Coston2) when unset.
NEXT_PUBLIC_GATEWAY_CHAIN_ID=114

# Demo mode: run the full deposit/trade/close/withdraw flow locally with real
# MetaMask signature popups but simulated (in-browser) results, no backend. It
# auto-engages when privacy mode is on but NEXT_PUBLIC_GATEWAY_URL is empty, so
# the flow is testable with nothing deployed. Force it with "true" / disable the
# auto-engage by setting a real gateway URL above.
NEXT_PUBLIC_DEMO_MODE=
