# Copy to .env.local and fill in. Restart `npm run dev` after changes.

# Which Flare testnet the InstructionSender is deployed on: coston | coston2
NEXT_PUBLIC_CHAIN=coston

# Deployed HyperliquidInstructionSender address (see ../config/extension.env).
# NOTE: this changes every time pre-build/full-setup redeploys the contract.
NEXT_PUBLIC_INSTRUCTION_SENDER=0x012bB7A094e044DA1fB6f7919f55A18f03304e57

# Vault-mode addresses (printed by `deploy-vault`). Required for the two-step
# deposit (mint→approve→escrow) and withdraw (request→executeWithdraw) flows.
NEXT_PUBLIC_TESTUSDC=
NEXT_PUBLIC_VAULT=

# Instruction fee forwarded as msg.value, in wei.
# Mirrors tools/pkg/utils/instructions.go (opts.Value = 1000000).
NEXT_PUBLIC_INSTRUCTION_FEE_WEI=1000000

# Public URL of the TEE proxy (SERVER-SIDE ONLY — never exposed to the browser).
# Today this is the ephemeral tunnel in front of the node, e.g.
#   https://<sub>.trycloudflare.com   or   https://<id>.ngrok-free.dev
# Must be reachable from wherever `next` runs (your laptop for the spike).
TEE_PROXY_URL=
